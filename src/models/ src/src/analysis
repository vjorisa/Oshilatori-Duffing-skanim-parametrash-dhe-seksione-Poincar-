def poincare_section(sol, params, n_periods_skip=50, n_points=1000):
    """
    Ekstrakton seksionin Poincaré duke kampionuar në perioda të forcës së jashtme.
    
    Parametrat:
    -----------
    sol : OdeResult
        Zgjidhja e sistemit
    params : dict
        Parametrat e sistemit
    n_periods_skip : int
        Numri i periodave për të anashkaluar (transientet)
    n_points : int
        Numri i pikave për të kampionuar në seksionin Poincaré
    
    Kthen:
    ------
    x_p : array
        Vlerat e x në seksionin Poincaré
    v_p : array
        Vlerat e v në seksionin Poincaré
    """
    T = compute_period_driving(params)
    t = sol.t
    x = sol.y[0]
    v = sol.y[1]
    
    # Gjej kohën e fillimit të kampionimit (pas transientëve)
    t_start = t[0] + n_periods_skip * T
    t_end = t[-1]
    
    # Kampiono në kohëra t = t_start + n*T
    t_poincare = []
    x_poincare = []
    v_poincare = []
    
    n = 0
    while True:
        t_sample = t_start + n * T
        if t_sample > t_end:
            break
        
        # Interpolim linear për të gjetur vlerën në kohën e saktë
        idx = np.searchsorted(t, t_sample)
        if idx >= len(t):
            break
        if idx == 0:
            n += 1
            continue
        
        # Interpolim linear
        t1, t2 = t[idx-1], t[idx]
        x1, x2 = x[idx-1], x[idx]
        v1, v2 = v[idx-1], v[idx]
        
        if t2 == t1:
            n += 1
            continue
        
        frac = (t_sample - t1) / (t2 - t1)
        x_sample = x1 + frac * (x2 - x1)
        v_sample = v1 + frac * (v2 - v1)
        
        t_poincare.append(t_sample)
        x_poincare.append(x_sample)
        v_poincare.append(v_sample)
        
        n += 1
        
        if len(t_poincare) >= n_points:
            break
    
    return np.array(x_poincare), np.array(v_poincare), np.array(t_poincare)


def poincare_section_dense(sol_dense, params, n_periods_skip=100, n_points=2000):
    """
    Version më i saktë duke përdorur dense_output nga solve_ivp.
    """
    T = compute_period_driving(params)
    
    # Kampiono në kohëra të sakta
    t_start = sol_dense.t[0] + n_periods_skip * T
    t_end = sol_dense.t[-1]
    
    n_max = int((t_end - t_start) / T)
    n_points = min(n_points, n_max)
    
    t_samples = t_start + np.arange(n_points) * T
    
    # Përdor dense_output për vlerësim të saktë
    y_samples = sol_dense.sol(t_samples)
    
    x_poincare = y_samples[0]
    v_poincare = y_samples[1]
    
    return x_poincare, v_poincare, t_samples


def plot_poincare(x_p, v_p, params, save_path=None, title_suffix="", 
                  color='blue', alpha=0.6, s=10):
    """
    Vizualizon seksionin Poincaré.
    """
    fig, ax = plt.subplots(figsize=(8, 8))
    
    ax.scatter(x_p, v_p, c=color, alpha=alpha, s=s, edgecolors='none')
    
    ax.set_xlabel('$x$')
    ax.set_ylabel('$v$')
    
    gamma = params['gamma']
    omega = params['omega']
    delta = params['delta']
    
    title = f'Seksioni Poincaré\\n$\\gamma={gamma}, \\omega={omega}, \\delta={delta}$'
    title += title_suffix
    ax.set_title(title)
    ax.grid(True, alpha=0.3)
    ax.set_aspect('equal', adjustable='box')
    
    # Shto statistika
    n_points = len(x_p)
    ax.text(0.02, 0.98, f'Pika: {n_points}', transform=ax.transAxes,
            verticalalignment='top', fontsize=9,
            bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.5))
    
    plt.tight_layout()
    
    if save_path:
        plt.savefig(save_path, bbox_inches='tight')
        print(f"Figura u ruajt në: {save_path}")
    
    return fig


def plot_multiple_poincare(gamma_values, params_base, t_span, y0, 
                            save_path=None, n_periods_skip=100):
    """
    Vizualizon seksione Poincaré për vlera të ndryshme të γ.
    """
    from ..models.duffing import simulate_duffing
    
    n_plots = len(gamma_values)
    cols = min(3, n_plots)
    rows = (n_plots + cols - 1) // cols
    
    fig, axes = plt.subplots(rows, cols, figsize=(5*cols, 5*rows))
    if n_plots == 1:
        axes = [axes]
    else:
        axes = axes.flatten()
    
    colors = plt.cm.viridis(np.linspace(0, 1, n_plots))
    
    for i, (gamma, color, ax) in enumerate(zip(gamma_values, colors, axes)):
        params = params_base.copy()
        params['gamma'] = gamma
        
        # Simulo për kohë më të gjatë për transientë të gjatë
        sol = simulate_duffing(t_span, y0, params, 
                               max_step=params['omega']/(20*2*np.pi))
        
        x_p, v_p, _ = poincare_section_dense(sol, params, 
                                              n_periods_skip=n_periods_skip)
        
        ax.scatter(x_p, v_p, c=[color], alpha=0.6, s=8, edgecolors='none')
        ax.set_xlabel('$x$')
        ax.set_ylabel('$v$')
        ax.set_title(f'$\\gamma = {gamma}$')
        ax.grid(True, alpha=0.3)
        ax.set_aspect('equal', adjustable='box')
    
    # Fshi axes e tepërta
    for j in range(i+1, len(axes)):
        fig.delaxes(axes[j])
    
    fig.suptitle('Seksionet Poincaré për Vlera të Ndryshme të $\\gamma$', 
                 fontsize=14, y=1.02)
    plt.tight_layout()
    
    if save_path:
        plt.savefig(save_path, bbox_inches='tight')
        print(f"Figura u ruajt në: {save_path}")
    
    return fig


def scan_parameter(param_name, param_values, params_base, t_span, y0,
                    n_periods_skip=100, n_poincare_points=500):
    """
    Skanon një parametër dhe kthen seksionet Poincaré për çdo vlerë.
    
    Parametrat:
    -----------
    param_name : str
        Emri i parametrit për të skanuar ('gamma', 'delta', 'omega')
    param_values : array_like
        Vlerat e parametrit për të testuar
    params_base : dict
        Parametrat bazë
    t_span : tuple
        Intervali kohor
    y0 : array_like
        Kushtet fillestare
    
    Kthen:
    ------
    results : list
        Listë me tuples (param_value, x_p, v_p)
    """
    from ..models.duffing import simulate_duffing
    
    results = []
    
    for val in param_values:
        params = params_base.copy()
        params[param_name] = val
        
        print(f"Simulimi për {param_name} = {val:.4f}...")
        
        sol = simulate_duffing(t_span, y0, params,
                               max_step=params['omega']/(20*2*np.pi))
        
        x_p, v_p, _ = poincare_section_dense(sol, params, 
                                             n_periods_skip=n_periods_skip,
                                             n_points=n_poincare_points)
        
        results.append((val, x_p, v_p))
    
    return results


